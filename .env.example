# Пример конфигурационного файла .env
# Скопируйте этот файл в .env и установите соответствующие значения
# ВАЖНО: Никогда не добавляйте файл .env в систему контроля версий!

# ===== Основные настройки сервера =====
# Режим работы: development, test, production
NODE_ENV=production
# Порт, на котором запускается сервер
PORT=3000
# Уровень логирования: error, warn, info, http, verbose, debug, silly
LOG_LEVEL=info

# ===== MongoDB конфигурация =====
# URI подключения к MongoDB
# Формат: mongodb://username:password@host:port/database
# Для локального развертывания:
# MONGO_URL=mongodb://localhost:27017/criminal-bluff
# Для продакшена (пример):
MONGO_URL=mongodb://username:password@host.example.com:27017/criminal-bluff

# ===== Redis конфигурация =====
# URI подключения к Redis для кэширования
# Формат: redis://username:password@host:port
# Для локального развертывания:
# REDIS_URL=redis://localhost:6379
# Для продакшена (пример):
REDIS_URL=redis://default:password@host.example.com:6379

# ===== Секреты аутентификации =====
# JWT секретный ключ для подписи токенов
# Должен быть длинным, уникальным и случайным
JWT_SECRET=your_jwt_secret_should_be_long_and_random_string_here
# Время жизни JWT токена в секундах (по умолчанию 24 часа)
JWT_EXPIRES_IN=86400

# ===== Telegram конфигурация =====
# Токен бота полученный от @BotFather
TELEGRAM_BOT_TOKEN=1234567890:ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghi
# ID администратора для управления ботом и получения уведомлений
TELEGRAM_ADMIN_ID=123456789
# URL вашего API сервера для обратных вызовов (вебхуков)
API_URL=https://your-domain.com

# ===== Настройки безопасности =====
# Ограничение запросов для защиты от DDoS атак
# Максимальное количество запросов с одного IP
RATE_LIMIT_MAX=100
# Период ограничения в миллисекундах (15 минут)
RATE_LIMIT_WINDOW_MS=900000
# Настройки CORS - разрешенные источники (через запятую)
CORS_ORIGINS=https://your-domain.com,https://t.me